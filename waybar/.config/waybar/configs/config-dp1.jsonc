{
  "include": ["~/.config/waybar/modules/modules.jsonc"],
  "layer": "top", // Waybar layer: "top" or "bottom"
  "position": "top", // Waybar position: "top", "bottom", "left", "right"
  "modules-left": ["hyprland/workspaces", "sway/mode"],
  "modules-center": ["hyprland/window", "custom/mediaplayer"],
  "modules-right": [
    "disk",
    "pulseaudio",
    "network",
    "clock",
    "tray"
  ]
}
