// ~/.config/waybar/modules
{
  "hyprland/workspaces": {
      "format": "{icon}",
      "format-icons": {
        "1": " ",
        "2": " ",
        "3": " ",
        "5": " ",
        "10": " ",
        "active": " ",
        "default": " ",
        "empty": " "
        //             
     },
           "persistent-workspaces": {
                 "*": [1, 2, 3, 4, 5]
           }
    },
    "hyprland/window":{
      "max-length": 50,
      "separate-outputs": true
    },
    "custom/mediaplayer": {
      "output": "DP-1",
      "format": "{} ",
      "return-type": "json",
      "exec": "~/.config/waybar/scripts/mediaplayer.sh", // Path to your custom script
      "exec-if": "pgrep playerctld", // Only execute if playerctld is running
      "on-click": "playerctl --player=spotify play-pause",
      "interval": 1 // Set refresh interval as needed
    },
    // Module configuration
    "sway/workspaces": {
      "disable-scroll": false,
      "all-outputs": true
    },

    "disk":{
      "interval": 30,
      "format": "{specific_used: 0.2f}GB/{total}",
      "unit": "GB"
    },

    "sway/mode": {
      "format": "<span style=\"italic\">{}</span>"
    },

    "pulseaudio": {
      "format": "{volume}% {icon}",
      "format-muted": "",
      "format-icons": {
        "default": ["", ""]
      },
      "on-click": "pavucontrol"
    },

    "network": {
      "format-wifi": "{essid} ({signalStrength}%) ",
      "format-ethernet": "{ifname} ({signalStrength}) ",
      "format-disconnected": "Disconnected ⚠",
      "tooltip": true
    },

    "cpu": {
      "format": "CPU {usage}%",
      "tooltip": false
    },

    "memory": {
      "format": "RAM {used:0.1f}G/{total:0.1f}G"
    },

    "battery": {
      "format": "{capacity}% {icon}",
      "format-icons": ["", "", "", "", ""]
    },

    "clock": {
      "format": "{:%m/%d %I:%M %p}",         // 12-hour format
      "timezone": "America/Los_Angeles"
    },

    "tray": {
      "icon-size": 16,
      "spacing": 5
    }
}
